{
  "name": "cul",
  "version": "1.0.0",
  "description": "Module to interact with Busware CUL / COC / SCC / CUNO running culfw",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./lib/*.js": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24"
  },
  "scripts": {
    "test": "node --test && npm run test:types",
    "test:types": "tsc -p types-test/tsconfig.json",
    "test:watch": "node --test --watch",
    "lint": "eslint . && prettier --check .",
    "lintfix": "eslint --fix . && prettier --write ."
  },
  "keywords": [
    "Smarthome",
    "Home Automation",
    "CUL",
    "COC",
    "SCC",
    "CUNO",
    "FS20",
    "FHT",
    "HomeMatic",
    "Max",
    "Busware",
    "culfw",
    "fhem",
    "868",
    "433"
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://github.com/hobbyquaker)",
  "contributors": [
    "Michel Verbraak https://github.com/1stsetup",
    "Bluefox https://github.com/GermanBluefox",
    "ns130291 https://github.com/ns130291",
    "Tim Römisch https://github.com/timroemisch",
    "Ingo Fischer https://github.com/Apollon77",
    "Michael Lorenz",
    "mreschka https://github.com/mreschka",
    "Andre Klärner https://github.com/klaernie",
    "Ferdinand Helmer https://github.com/ferdinandhelmer",
    "jpk75 https://github.com/jpk75"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/cul.git"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/cul/issues"
  },
  "homepage": "https://github.com/hobbyquaker/cul",
  "license": "GPL-2.0",
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
